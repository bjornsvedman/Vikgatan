@baseUrl = http://localhost:5084

### Get an antiforgery token (the response cookie is reused by the REST Client)
GET {{baseUrl}}/api/antiforgery/token
> {% client.global.set("csrfToken", response.body.requestToken); %}

### Upload a supported sample file; replace the path with a local PDF or image
POST {{baseUrl}}/api/documents/ingest
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: multipart/form-data; boundary=ReceiptBoundary

--ReceiptBoundary
Content-Disposition: form-data; name="file"; filename="receipt.pdf"
Content-Type: application/pdf

< ./sample-receipt.pdf
--ReceiptBoundary--
> {% client.global.set("receiptId", response.body.id); %}

### Get the uploaded receipt by ID
GET {{baseUrl}}/api/documents/{{receiptId}}

### List receipts awaiting review
GET {{baseUrl}}/api/documents/review-queue

### Browse all receipts, newest document year first
GET {{baseUrl}}/api/documents/archive

### Sort by category within each year and filter reviewed SEK receipts
GET {{baseUrl}}/api/documents/archive?sortBy=category&direction=asc&status=Completed&currency=SEK&page=1&pageSize=25

### Filter by year, category, and document date range
GET {{baseUrl}}/api/documents/archive?year=2024&category=Flooring&dateFrom=2024-01-01&dateTo=2024-12-31

### Find undated and uncategorized receipts
GET {{baseUrl}}/api/documents/archive?undated=true&uncategorized=true

### Review, approve, or correct an approved receipt; keep markReviewed=true and send all fields/items
PUT {{baseUrl}}/api/documents/{{receiptId}}/review
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{
	"vendor": "Tile House",
	"documentDate": "2024-05-12",
	"currency": "SEK",
	"totalAmount": 125.50,
	"category": "Flooring",
	"description": "Kitchen floor tiles",
	"markReviewed": true,
	"lineItems": [
		{
			"description": "Ceramic tile",
			"quantity": 10,
			"unitPrice": 12.55,
			"lineTotal": 125.50,
			"category": "Flooring"
		}
	]
}

### Preview the original uploaded document
GET {{baseUrl}}/api/documents/{{receiptId}}/file

### Ask a question about stored receipts
POST {{baseUrl}}/api/documents/query
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{
	"question": "Which receipts mention flooring work?"
}

### Calculate totals with interpreted scope and every contributing receipt in calculation
POST {{baseUrl}}/api/documents/query
X-CSRF-TOKEN: {{csrfToken}}
Content-Type: application/json

{
	"question": "Show my total spending grouped by document year."
}